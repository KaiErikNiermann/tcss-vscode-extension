{
  "scopeName": "tcss.python.injection",
  "injectionSelector": "L:source.python",
  "patterns": [
    {
      "include": "#tcss-triple-double-quoted"
    },
    {
      "include": "#tcss-triple-single-quoted"
    },
    {
      "include": "#tcss-double-quoted"
    },
    {
      "include": "#tcss-single-quoted"
    }
  ],
  "repository": {
    "tcss-triple-double-quoted": {
      "begin": "^(\\s*)((?:DEFAULT_)?CSS)(\\s*)(=)(\\s*)(\"\"\")",
      "beginCaptures": {
        "2": {
          "name": "constant.other.caps.python"
        },
        "4": {
          "name": "keyword.operator.assignment.python"
        },
        "6": {
          "name": "string.quoted.multi.python punctuation.definition.string.begin.python"
        }
      },
      "end": "(\"\"\")",
      "endCaptures": {
        "1": {
          "name": "string.quoted.multi.python punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "source.tcss"
        }
      ]
    },
    "tcss-triple-single-quoted": {
      "begin": "^(\\s*)((?:DEFAULT_)?CSS)(\\s*)(=)(\\s*)(''')",
      "beginCaptures": {
        "2": {
          "name": "constant.other.caps.python"
        },
        "4": {
          "name": "keyword.operator.assignment.python"
        },
        "6": {
          "name": "string.quoted.multi.python punctuation.definition.string.begin.python"
        }
      },
      "end": "(''')",
      "endCaptures": {
        "1": {
          "name": "string.quoted.multi.python punctuation.definition.string.end.python"
        }
      },
      "patterns": [
        {
          "include": "source.tcss"
        }
      ]
    },
    "tcss-double-quoted": {
      "match": "^(\\s*)((?:DEFAULT_)?CSS)(\\s*)(=)(\\s*)(\")([^\"\\n]*\\{[^\"\\n]*)(\")",
      "captures": {
        "2": {
          "name": "constant.other.caps.python"
        },
        "4": {
          "name": "keyword.operator.assignment.python"
        },
        "6": {
          "name": "string.quoted.single.python punctuation.definition.string.begin.python"
        },
        "7": {
          "patterns": [
            {
              "include": "source.tcss"
            }
          ]
        },
        "8": {
          "name": "string.quoted.single.python punctuation.definition.string.end.python"
        }
      }
    },
    "tcss-single-quoted": {
      "match": "^(\\s*)((?:DEFAULT_)?CSS)(\\s*)(=)(\\s*)(')([^'\\n]*\\{[^'\\n]*)(')",
      "captures": {
        "2": {
          "name": "constant.other.caps.python"
        },
        "4": {
          "name": "keyword.operator.assignment.python"
        },
        "6": {
          "name": "string.quoted.single.python punctuation.definition.string.begin.python"
        },
        "7": {
          "patterns": [
            {
              "include": "source.tcss"
            }
          ]
        },
        "8": {
          "name": "string.quoted.single.python punctuation.definition.string.end.python"
        }
      }
    }
  }
}
