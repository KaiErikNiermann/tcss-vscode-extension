{
  "name": "textual-syntax-highlighter",
  "displayName": "Textual Syntax Highlighter (Community)",
  "description": "Syntax highlighting for Textual CSS (.tcss) and for TCSS embedded in Python. Community-maintained fork of Textualize/tcss-vscode-extension.",
  "version": "1.3.1",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaiErikNiermann/tcss-vscode-extension.git"
  },
  "publisher": "kaierikniermann",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "Textual CSS",
        "extensions": [
          ".tcss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "Textual CSS",
        "scopeName": "source.tcss",
        "path": "./syntaxes/tcss.tmGrammar.json"
      },
      {
        "path": "./syntaxes/python.injection.json",
        "scopeName": "tcss.python.injection",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.79.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "js-yaml": "^4.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KaiErikNiermann/tcss-vscode-extension/issues"
  },
  "homepage": "https://github.com/KaiErikNiermann/tcss-vscode-extension#readme",
  "keywords": [
    "textual",
    "tcss",
    "textual-css",
    "python",
    "tui",
    "syntax-highlighting"
  ]
}
